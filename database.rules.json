{
  "rules": {
    ".read": false,
    ".write": false,
    "roomIndex": {
      ".read": "auth != null && query.orderByValue && query.endAt < now - 86400000",
      ".indexOn": ".value",
      "$code": {
        ".write": "auth != null && $code.matches(/^[A-Z]{4}$/) && ((!data.exists() && newData.val() === now && root.child('rooms').child($code).child('meta').child('hostId').val() === auth.uid) || (data.exists() && !newData.exists() && data.val() < now - 86400000))",
        ".validate": "newData.isNumber()"
      }
    },
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && $code.matches(/^[A-Z]{4}$/) && ((!data.exists() && newData.child('meta').child('hostId').val() === auth.uid) || (data.exists() && !newData.exists() && (data.child('meta').child('hostId').val() === auth.uid || data.child('meta').child('createdAt').val() < now - 86400000)))",
        "meta": {
          ".write": "auth != null && data.child('hostId').val() === auth.uid && newData.child('hostId').val() === auth.uid",
          ".validate": "newData.hasChildren(['hostId', 'createdAt'])",
          "hostId": {
            ".write": "auth != null && data.exists() && newData.val() === auth.uid && root.child('rooms').child($code).child('players').child(auth.uid).exists() && (!root.child('rooms').child($code).child('players').child(data.val()).exists() || (root.child('rooms').child($code).child('players').child(data.val()).child('online').val() === false && root.child('rooms').child($code).child('players').child(data.val()).child('lastSeen').val() < now - 10000))",
            ".validate": "newData.isString() && newData.val().length < 64"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && ((data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() === now))"
          },
          "settings": {
            "writeSec": {
              ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 300"
            },
            "drawSec": {
              ".validate": "newData.isNumber() && newData.val() >= 20 && newData.val() <= 600"
            },
            "maxRounds": {
              ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 20"
            },
            "hostPlays": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "players": {
          "$pid": {
            ".write": "auth != null && root.child('rooms').child($code).child('meta').child('hostId').exists() && (auth.uid === $pid || (!newData.exists() && root.child('rooms').child($code).child('meta').child('hostId').val() === auth.uid))",
            ".validate": "newData.hasChildren(['name', 'avatar', 'color'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
            },
            "avatar": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "color": {
              ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
            },
            "online": {
              ".validate": "newData.isBoolean()"
            },
            "lastSeen": {
              ".validate": "newData.isNumber()"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "phase": {
          ".write": "auth != null && root.child('rooms').child($code).child('meta').child('hostId').val() === auth.uid",
          ".validate": "newData.child('state').val() === 'lobby' || newData.child('state').val() === 'play' || newData.child('state').val() === 'album' || newData.child('state').val() === 'vote' || newData.child('state').val() === 'results'",
          "state": {
            ".validate": "newData.isString()"
          },
          "round": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100"
          },
          "rounds": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20"
          },
          "startedAt": {
            ".validate": "newData.isNumber()"
          },
          "duration": {
            ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 600"
          },
          "order": {
            "$i": {
              ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.isString() && newData.val().length < 64"
            }
          },
          "done": {
            "$pid": {
              ".write": "auth != null && auth.uid === $pid && root.child('rooms').child($code).child('players').child($pid).exists()",
              ".validate": "newData.isNumber()"
            }
          },
          "album": {
            "c": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100"
            },
            "s": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100"
            },
            "$other": {
              ".validate": false
            }
          },
          "results": {
            "top": {
              "$i": {
                "c": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100"
                },
                "v": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "best": {
              "c": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100"
              },
              "s": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100"
              },
              "v": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000"
              },
              "$other": {
                ".validate": false
              }
            },
            "voters": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "chains": {
          ".write": "auth != null && !newData.exists() && root.child('rooms').child($code).child('meta').child('hostId').val() === auth.uid",
          "$ci": {
            ".validate": "$ci.matches(/^[0-9]{1,2}$/)",
            "steps": {
              "$r": {
                ".write": "auth != null && !data.exists() && newData.exists() && root.child('rooms').child($code).child('phase').child('state').val() === 'play' && ((newData.child('a').val() === auth.uid && root.child('rooms').child($code).child('players').child(auth.uid).exists()) || root.child('rooms').child($code).child('meta').child('hostId').val() === auth.uid)",
                ".validate": "$r.matches(/^[0-9]{1,2}$/) && newData.hasChildren(['t', 'a', 'n', 'v'])",
                "t": {
                  ".validate": "newData.val() === 'text' || newData.val() === 'draw'"
                },
                "a": {
                  ".validate": "newData.isString() && newData.val().length < 64"
                },
                "n": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
                },
                "v": {
                  ".validate": "newData.isString() && ((newData.parent().child('t').val() === 'text' && newData.val().length <= 200) || (newData.parent().child('t').val() === 'draw' && newData.val().length <= 120000 && (newData.val().length === 0 || newData.val().beginsWith('data:image/'))))"
                },
                "s": {
                  ".validate": "newData.isBoolean()"
                },
                "p": {
                  ".validate": "newData.isString() && newData.val().length <= 40000"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "votes": {
          ".write": "auth != null && !newData.exists() && root.child('rooms').child($code).child('meta').child('hostId').val() === auth.uid",
          "$pid": {
            ".write": "auth != null && auth.uid === $pid && root.child('rooms').child($code).child('players').child(auth.uid).exists() && root.child('rooms').child($code).child('phase').child('state').val() === 'vote'",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 100"
          }
        },
        "stars": {
          ".write": "auth != null && !newData.exists() && root.child('rooms').child($code).child('meta').child('hostId').val() === auth.uid",
          "$key": {
            ".validate": "$key.matches(/^[0-9]{1,2}_[0-9]{1,2}$/)",
            "$pid": {
              ".write": "auth != null && auth.uid === $pid && root.child('rooms').child($code).child('players').child(auth.uid).exists()",
              ".validate": "newData.isBoolean()"
            }
          }
        },
        "reactions": {
          ".write": "auth != null && !newData.exists() && root.child('rooms').child($code).child('meta').child('hostId').val() === auth.uid",
          "$pid": {
            ".write": "auth != null && auth.uid === $pid && root.child('rooms').child($code).child('players').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['e', 't'])",
            "e": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 8"
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() > now - 60000 && newData.val() < now + 60000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "memIndex": {
      ".read": "auth != null && query.orderByValue && query.endAt < now - 86400000",
      ".indexOn": ".value",
      "$code": {
        ".write": "auth != null && $code.matches(/^[A-Z]{4}$/) && ((!data.exists() && newData.val() === now && root.child('mem').child($code).child('meta').child('hostId').val() === auth.uid) || (data.exists() && !newData.exists() && data.val() < now - 86400000))",
        ".validate": "newData.isNumber()"
      }
    },
    "mem": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && $code.matches(/^[A-Z]{4}$/) && ((!data.exists() && newData.child('meta').child('hostId').val() === auth.uid) || (data.exists() && !newData.exists() && (data.child('meta').child('hostId').val() === auth.uid || data.child('meta').child('createdAt').val() < now - 86400000)))",
        "meta": {
          ".write": "auth != null && data.child('hostId').val() === auth.uid && newData.child('hostId').val() === auth.uid",
          ".validate": "newData.hasChildren(['hostId', 'createdAt'])",
          "hostId": {
            ".write": "auth != null && data.exists() && newData.val() === auth.uid && root.child('mem').child($code).child('players').child(auth.uid).exists() && (!root.child('mem').child($code).child('players').child(data.val()).exists() || (root.child('mem').child($code).child('players').child(data.val()).child('online').val() === false && root.child('mem').child($code).child('players').child(data.val()).child('lastSeen').val() < now - 10000))",
            ".validate": "newData.isString() && newData.val().length < 64"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && ((data.exists() && newData.val() === data.val()) || (!data.exists() && newData.val() === now))"
          },
          "settings": {
            "pickSec": {
              ".validate": "newData.isNumber() && newData.val() >= 15 && newData.val() <= 300"
            },
            "voteSec": {
              ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 300"
            },
            "rounds": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20"
            },
            "hostPlays": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "players": {
          "$pid": {
            ".write": "auth != null && root.child('mem').child($code).child('meta').child('hostId').exists() && (auth.uid === $pid || (!newData.exists() && root.child('mem').child($code).child('meta').child('hostId').val() === auth.uid))",
            ".validate": "newData.hasChildren(['name', 'avatar', 'color'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
            },
            "avatar": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "color": {
              ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
            },
            "online": {
              ".validate": "newData.isBoolean()"
            },
            "lastSeen": {
              ".validate": "newData.isNumber()"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "phase": {
          ".write": "auth != null && root.child('mem').child($code).child('meta').child('hostId').val() === auth.uid",
          ".validate": "newData.child('state').val() === 'lobby' || newData.child('state').val() === 'pick' || newData.child('state').val() === 'vote' || newData.child('state').val() === 'score' || newData.child('state').val() === 'final'",
          "state": {
            ".validate": "newData.isString()"
          },
          "round": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99"
          },
          "rounds": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20"
          },
          "startedAt": {
            ".validate": "newData.isNumber()"
          },
          "duration": {
            ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 600"
          },
          "order": {
            "$i": {
              ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.isString() && newData.val().length < 64"
            }
          },
          "sits": {
            "$i": {
              ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.isNumber() && newData.val() >= 0 && newData.val() < 10000"
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "deal": {
          ".write": "auth != null && root.child('mem').child($code).child('meta').child('hostId').val() === auth.uid",
          "$pid": {
            "$i": {
              ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.isNumber() && newData.val() >= 0 && newData.val() < 1000"
            }
          }
        },
        "plays": {
          ".write": "auth != null && !newData.exists() && root.child('mem').child($code).child('meta').child('hostId').val() === auth.uid",
          "$r": {
            ".validate": "$r.matches(/^[0-9]{1,2}$/)",
            "$pid": {
              ".write": "auth != null && auth.uid === $pid && !data.exists() && root.child('mem').child($code).child('players').child(auth.uid).exists() && root.child('mem').child($code).child('phase').child('state').val() === 'pick'",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1000"
            }
          }
        },
        "votes": {
          ".write": "auth != null && !newData.exists() && root.child('mem').child($code).child('meta').child('hostId').val() === auth.uid",
          "$r": {
            ".validate": "$r.matches(/^[0-9]{1,2}$/)",
            "$pid": {
              ".write": "auth != null && auth.uid === $pid && root.child('mem').child($code).child('players').child(auth.uid).exists() && root.child('mem').child($code).child('phase').child('state').val() === 'vote'",
              ".validate": "newData.isString() && newData.val().length < 64"
            }
          }
        },
        "reactions": {
          ".write": "auth != null && !newData.exists() && root.child('mem').child($code).child('meta').child('hostId').val() === auth.uid",
          "$pid": {
            ".write": "auth != null && auth.uid === $pid && root.child('mem').child($code).child('players').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['e', 't'])",
            "e": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 8"
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() > now - 60000 && newData.val() < now + 60000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}